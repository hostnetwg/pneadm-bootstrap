# Konfiguracja dev-pull.sh — skopiuj do ~/.config/pne/dev-pull.env (poza repo, chmod 600).
# W tym pliku NIE ma haseł. Hasło do klucza SSH trzyma agent (ssh-add).
#
#   mkdir -p ~/.config/pne && cp scripts/dev-sync/dev-pull.env.example ~/.config/pne/dev-pull.env
#   chmod 600 ~/.config/pne/dev-pull.env

SSH_HOST="h30.seohost.pl"
SSH_PORT=""              # WPISZ port SSH z maila SeoHost o aktywacji dostępu
SSH_USER="srv66127"
SSH_KEY="$HOME/.ssh/pne_devsync_ed25519"   # klucz OGRANICZONY (tylko odczyt zrzutów i storage/app)

# Katalogi projektów na TYM komputerze (domyślnie: repo pneadm i obok niego pnedu)
# PNEADM_DIR="$HOME/WEB-APP/pneadm"
# PNEDU_DIR="$HOME/WEB-APP/pnedu"

# Gdzie trzymać pobrane zrzuty i lokalne snapshoty baz (poza repo)
# DEV_SYNC_HOME="$HOME/pne-dev-sync"

# Kontener MySQL ze Sail (wspólny dla pneadm i pnedu)
# MYSQL_CONTAINER="pneadm-mysql"

# Ile ostatnich zestawów lokalnych snapshotów baz zostawiać
# KEEP_SNAPSHOTS=3

# 1 = wolno importować bazę, gdy lokalne PAYU_SANDBOX/PAYNOW_SANDBOX są false (NIE zalecane)
# ALLOW_LIVE_PAYMENTS=0
